# Copy this file to .env and update with your computer's IP address
# To find your IP:
# Windows: ipconfig (look for Wi-Fi adapter IPv4 Address)
# Mac: ifconfig | grep "inet " (look for en0)
# Linux: ip addr show (look for wlan0 or eth0)

API_BASE_URL=http://YOUR_COMPUTER_IP:5264/api

# Example:
# API_BASE_URL=http://192.168.1.10:5264/api
